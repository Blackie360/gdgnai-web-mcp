{
  "tools": [
    {
      "name": "event_lookup",
      "readOnly": true,
      "description": "Returns event basics, source links, themes, venue, and RSVP URL.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "includeSources": {
            "type": "boolean",
            "description": "Include public source links in the response."
          }
        },
        "additionalProperties": false
      },
      "outputShape": {
        "event": "EventInfo",
        "sources": "SourceLink[]"
      },
      "example": {
        "input": { "includeSources": true },
        "resultPath": "/webmcp/event.json#event"
      }
    },
    {
      "name": "sessions_search",
      "readOnly": true,
      "description": "Finds agenda sessions by text, speaker, room, theme, or time.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": { "type": "string" },
          "speaker": { "type": "string" },
          "room": { "type": "string" },
          "theme": { "type": "string" },
          "time": { "type": "string" }
        },
        "additionalProperties": false
      },
      "outputShape": {
        "matches": "AgendaItem[]"
      },
      "example": {
        "input": { "theme": "WebMCP" },
        "resultPath": "/webmcp/event.json#agenda"
      }
    },
    {
      "name": "speakers_profile",
      "readOnly": true,
      "description": "Returns public speaker details and linked agenda appearances.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" }
        },
        "additionalProperties": false
      },
      "outputShape": {
        "speaker": "Speaker",
        "sessions": "AgendaItem[]"
      },
      "example": {
        "input": { "name": "Felix Jumason" },
        "resultPath": "/webmcp/event.json#agenda"
      }
    },
    {
      "name": "agenda_explore",
      "readOnly": true,
      "description": "Groups the day by time, room, or session type.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "groupBy": {
            "type": "string",
            "enum": ["time", "room", "type"]
          },
          "type": { "type": "string" },
          "time": { "type": "string" }
        },
        "additionalProperties": false
      },
      "outputShape": {
        "groups": "Record<string, AgendaItem[]>"
      },
      "example": {
        "input": { "groupBy": "time" },
        "resultPath": "/webmcp/event.json#agenda"
      }
    },
    {
      "name": "recommendations_list",
      "readOnly": true,
      "description": "Returns curated paths for different attendee goals.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "audience": { "type": "string" },
          "theme": { "type": "string" }
        },
        "additionalProperties": false
      },
      "outputShape": {
        "recommendations": "Recommendation[]"
      },
      "example": {
        "input": { "audience": "first-time" },
        "resultPath": "/webmcp/event.json#recommendations"
      }
    },
    {
      "name": "event_brief",
      "readOnly": true,
      "description": "Generates a concise event brief from the public event dataset.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "format": {
            "type": "string",
            "enum": ["attendee", "speaker", "organizer", "closing"]
          }
        },
        "additionalProperties": false
      },
      "outputShape": {
        "brief": "string",
        "citations": "SourceLink[]"
      },
      "example": {
        "input": { "format": "attendee" },
        "resultPath": "/webmcp/event.json"
      }
    }
  ],
  "privacy": {
    "readOnly": true,
    "collectsPersonalData": false,
    "requiresAuthentication": false,
    "notes": "These tools are static descriptions for deterministic read-only lookups over public event data. They do not mutate state or collect attendee information."
  }
}
